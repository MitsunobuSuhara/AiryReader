<Window x:Class="AiryPdf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="airyPDF 1.1" Width="1180" Height="840" MinWidth="860" MinHeight="560" Background="#F5F7FA" FontFamily="Yu Gothic UI" FontSize="14" Icon="Assets/icon.png"
 UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DEE4EA" BorderThickness="0,0,0,1" Padding="14,10">
   <WrapPanel>
    <Button Content="開く" Click="OpenClick" ToolTip="開く&#10;Ctrl+O" ToolTipService.InitialShowDelay="250"/>
    <Button Content="印刷" Click="PrintClick" ToolTip="印刷&#10;Ctrl+P" ToolTipService.InitialShowDelay="250"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="16,8"><TextBlock x:Name="Status" Text="PDFを開くか、この画面にドラッグしてください。" TextWrapping="Wrap"/></Border>
  <StackPanel DockPanel.Dock="Top">
   <TabControl x:Name="Tabs" SelectionChanged="TabChanged" Margin="12,8,12,0" MinHeight="35"/>
   <WrapPanel Margin="12,5">
    <Button Content="‹" Click="PreviousClick"/><TextBox x:Name="PageNumber" Text="1" Width="48" KeyDown="PageNumberKeyDown"/><TextBlock x:Name="PageCount" Text="/ —" Margin="3,0,10,0"/><Button Content="›" Click="NextClick"/>
    <Button Content="−" Click="ZoomOutClick"/><TextBox x:Name="ZoomText" Text="100" Width="66" TextAlignment="Right" KeyDown="ZoomInputKeyDown" LostKeyboardFocus="ZoomInputLostFocus" GotKeyboardFocus="ZoomInputGotFocus" ToolTip="表示倍率（10～800％）。入力してEnterで確定" AutomationProperties.Name="表示倍率"/><TextBlock Text="%"/><Button Content="＋" Click="ZoomInClick"/>
    <Button Content="↶" FontFamily="Segoe UI Symbol" FontSize="21" Padding="10,2" Click="RotateLeftClick" ToolTip="左に90度回転" AutomationProperties.Name="左に90度回転"/><Button Content="↷" FontFamily="Segoe UI Symbol" FontSize="21" Padding="10,2" Click="RotateRightClick" ToolTip="右に90度回転" AutomationProperties.Name="右に90度回転"/><Button Content="画面幅に合わせる" Click="FitClick"/>

   </WrapPanel>
  </StackPanel>
  <Grid Background="#BCC3CC">
   <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center">
    <TextBlock Text="軽やかに開く。寸法を守って印刷する。" FontSize="25" Foreground="#334155" HorizontalAlignment="Center"/>
    <TextBlock Text="PDFをドラッグするか、「開く」を選んでください。" Margin="0,18" Foreground="#64748B" HorizontalAlignment="Center"/>
   </StackPanel>
   <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ViewerWheel" ScrollChanged="ViewerScrolled">
    <StackPanel x:Name="PagesHost" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
